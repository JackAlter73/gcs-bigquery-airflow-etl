# Copy to .env locally. Never commit real values.

# GCP
GCP_PROJECT_ID=your-gcp-project
GCP_LOCATION=US
GCS_BUCKET=your-demo-bucket
GCS_LANDING_PREFIX=landing/orders

# BigQuery datasets (demo names only)
BQ_DATASET_RAW=raw
BQ_DATASET_CURATED=curated
BQ_TABLE_ORDERS=orders

# Airflow / runtime
AIRFLOW_HOME=./
# Path to a service account JSON on the machine that runs Airflow.
# Leave empty if you use Application Default Credentials / Workload Identity.
GOOGLE_APPLICATION_CREDENTIALS=

# Optional default. Prefer dag_run.conf.business_date or the filename.
# Do not treat "today" as the business date.
# DEMO_BUSINESS_DATE=2026-09-01
