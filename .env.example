# Copy to .env locally. Never commit real values.

# GCP
# Wrong project id: run_once cannot create datasets or load files.
GCP_PROJECT_ID=your-gcp-project
# Must match the bucket and dataset location. Mismatch fails CREATE SCHEMA.
GCP_LOCATION=US
# Bucket must already exist. The script will not create it.
GCS_BUCKET=your-demo-bucket
# Object key prefix. Landing file must be orders_YYYY-MM-DD.csv under this prefix.
GCS_LANDING_PREFIX=landing/orders

# BigQuery datasets (demo names only)
# Created by run_once / the DAG if missing. Do not reuse employer dataset names.
BQ_DATASET_RAW=raw
BQ_DATASET_CURATED=curated
BQ_TABLE_ORDERS=orders

# Airflow / runtime
# Unused by validate_orders and run_once. Leave as-is unless you run an Airflow box.
AIRFLOW_HOME=./
# Path to a service account JSON on the Airflow machine.
# Leave empty to use Application Default Credentials (gcloud auth application-default login).
GOOGLE_APPLICATION_CREDENTIALS=

# Do not set a clock date here. Pass business_date on the trigger or use the filename.
# DEMO_BUSINESS_DATE=2026-09-01